# Copy this file to `.env` and fill in the values. Never commit `.env`.
# On Hostinger, enter the same names and values as the app's environment variables.

# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Your site address (no trailing slash) ---
APP_URL="https://evnt.co"

# --- Security: long random strings (openssl rand -base64 32) ---
SESSION_SECRET=""
CRON_SECRET=""

# --- First super admin (created on deploy if missing) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Email (Hostinger mailbox) ---
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="no-reply@evnt.co"
SMTP_PASS=""
MAIL_FROM="EVNT <no-reply@evnt.co>"

# --- Google sign-in (optional; the button appears only when set) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Whish Money (only with official merchant credentials and documentation) ---
WHISH_API_BASE=""
WHISH_CHANNEL=""
WHISH_SECRET=""
WHISH_WEBSITE_URL=""

# --- Optional ---
# "true" loads clearly-labelled demo merchants and listings (local/sales only, never production)
# SEED_DEMO="true"
