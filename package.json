{
  "name": "evnt",
  "version": "0.1.0",
  "private": true,
  "description": "EVNT — Lebanon's family discovery, booking and shopping platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && npm run db:setup && UV_THREADPOOL_SIZE=2 NEXT_TELEMETRY_DISABLED=1 next build",
    "build:local": "prisma generate && next build",
    "start": "UV_THREADPOOL_SIZE=4 next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:setup": "tsx --tsconfig tsconfig.json --require ./scripts/cli-shim.cjs prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.8",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "leaflet": "1.9",
    "lucide-react": "^0.544.0",
    "next": "^15.5.28",
    "nodemailer": "^7.0.10",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
